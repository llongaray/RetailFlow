{
  "name": "@retailflow/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "prisma generate",
    "build": "nest build",
    "start": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "test:integration": "jest --testPathIgnorePatterns=/node_modules/ --testRegex=integration.spec.ts",
    "prisma:generate": "prisma generate"
